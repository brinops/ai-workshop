# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------- service
PUBLIC_URL=http://127.0.0.1:8000          # dashboard links in Slack; the hook also posts here
# RCP_API_URL=                            # override where the hook posts (defaults to PUBLIC_URL)
# RCP_API_TOKEN=                          # optional: require `Authorization: Bearer <token>` on /api/tasks/register
# RUN_WORKER=true                         # false when running `python -m app.worker` separately
# DATA_DIR=./var                          # SQLite DB, bare clones, worktrees, agent run bundles

# ---------------------------------------------------------------- GitHub
# GITHUB_TOKEN=                           # optional: defaults to `gh auth token`
# ALLOWED_REPOS=["brinops/ai-workshop"]   # JSON list; empty = any repo the token can access
# REQUIRED_CHECKS=["helm-validate"]       # check-run names that must pass
# GIT_REMOTE_TEMPLATE=git@github.com:{repo}.git   # use https://x-access-token:${TOKEN}@github.com/{repo}.git in containers
# GITHUB_WEBHOOK_SECRET=                  # enables POST /api/webhooks/github (secondary ingestion)
# CI_POLL_INTERVAL_SECONDS=15
# CI_WAIT_TIMEOUT_SECONDS=1200

# ---------------------------------------------------------------- Claude Code
# CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet
# AGENT_MAX_BUDGET_USD=2.0
# ANALYSIS_TIMEOUT_SECONDS=420
# REMEDIATION_TIMEOUT_SECONDS=600
# MAX_CONCURRENT_AGENTS=2
# ANTHROPIC_API_KEY=                      # only needed where the local `claude` login is unavailable (e.g. Docker)
# CLAUDE_CODE_OAUTH_TOKEN=                # alternative to ANTHROPIC_API_KEY (`claude setup-token`)

# ---------------------------------------------------------------- remediation policy
# REMEDIATION_ALLOWED_PATHS=["demo/charts/**"]
# REMEDIATION_MAX_CHANGED_LINES=40
# MAX_REMEDIATION_ATTEMPTS=2
# MIN_CONFIDENCE_FOR_AUTO_FIX=0.6
# PROTECTED_BRANCHES=["main","master","release/*","production"]

# ---------------------------------------------------------------- automation defaults (first start only; then persisted)
# DEFAULT_AUTO_ANALYZE=true
# DEFAULT_AUTO_REMEDIATE=true
# DEFAULT_AUTO_PUSH=false

# ---------------------------------------------------------------- Slack
SLACK_WEBHOOK_URL=

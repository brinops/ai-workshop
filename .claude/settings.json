{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/register_pr.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(workshop-investigation|workshop-communication|workshop-action)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_subagent.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(workshop-investigation|workshop-communication|workshop-action)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_subagent.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
